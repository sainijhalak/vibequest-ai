# ========================================================
# VibeQuest AI — Environment Configuration
# ========================================================

# Server Port
PORT=3001

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS Origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Mock AI Mode: Set to true to run tests and local dev without Anthropic API keys.
# Must be false in production.
MOCK_AI=true

# Anthropic API Key (required when MOCK_AI=false)
# Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic Model Identifier (e.g. claude-3-5-haiku-20241022 or claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
